<?xml version="1.0" encoding="utf-8"?>
<!--
  Zero-setup TV Receiver: this activity is intentionally blank. The real work
  happens in TvConnectionService (WebSocket + NSD + UDP discovery) and the
  overlay services. Views are kept (visibility=gone) only so R.id references
  in MainActivity still resolve. Settings is reachable via:
      adb shell am start -n com.cmdcenter.tvreceiver/.SettingsActivity
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_channel_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_ws_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_mdns_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_open_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
