# ===== Dependencies & Build Artifacts =====
node_modules/
build/
dist/
coverage/

# ===== OS & IDE junk =====
.DS_Store
*.log
.env*
!.env.example

# ===== Database (PGlite) =====
# data-server/pg/ is the runtime PGlite cache. It is auto-generated by
# @electric-sql/pglite on first server start. NOT meant to be committed or
# copied across devices - rebuild with `npm run dev` and restore from a
# JSON backup instead.
data-server/pg/

# Legacy JSON archives (one-time import artifacts from JSON->PGlite migration).
# Kept on disk for reference but excluded from version control.
data-server/*.json.bak

# Local backup snapshots (manual JSON dumps from UI "Download Backup" or CLI).
# Useful to keep on disk for history, but excluded from git to avoid
# committing user-specific data.
data-server/backups/
data-server/baseline-pre-test.json
data-server/wipe-payload.json

# ===== Test artifacts =====
test-backup-restore.ps1
verify-stations.ps1
inspect-backups.ps1
list-folders.ps1
